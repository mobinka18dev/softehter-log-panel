# SoftEther VPN Log Panel Configuration

# Application settings
APP_NAME="SoftEther VPN Log Panel"
APP_ENV=production
DEBUG=false
HOST=127.0.0.1
PORT=8080

# Security (Change SECRET_KEY to a secure 64-character random string in production)
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secure_hex_key_in_production_min_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database path (SQLite)
DATABASE_URL=sqlite:///./data/panel.db

# SoftEther Log Directory
# Path to SoftEther logs on the server (MUST be mounted or read-only accessible)
# For example on Ubuntu: /var/log/vpnserver or /usr/local/vpnserver
# The panel looks for server_log/ and security_log/ inside this directory.
SOFTETHER_LOG_DIR=./data/sample_logs

# Sync configuration
SYNC_INTERVAL_SECONDS=15
AUTO_SYNC_ENABLED=true
MAX_LOG_LINE_BATCH=5000
RAW_EVENTS_RETENTION_DAYS=60

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://127.0.0.1:8080,http://localhost:8080,http://192.168.5.6:8080"
